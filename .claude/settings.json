{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/.agents/skills/paper-relevance/scripts/guard_tool.py\" --project-root \"$CLAUDE_PROJECT_DIR\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
